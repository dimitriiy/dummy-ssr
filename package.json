{
  "name": "own-ssr",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --include src --ignore '*.timestamp-*' src/server.ts",
    "build": "vite build && SSR=true vite build",
    "start": "NODE_ENV=production node dist/server/server.js",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write src",
    "test": "echo \"Error: no test specified\""
  },
  "dependencies": {
    "express": "^4.19.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vite": "^5.3.0"
  }
}
